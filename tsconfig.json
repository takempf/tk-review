{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "tk-design-system": ["../tk-design-system/src/index.ts"],
      "tk-design-system/*": ["../tk-design-system/src/*"]
    }
  },
  "include": ["src", "dev-harness", "vite.config.ts"],
  // A standalone Node script, run manually via node's type stripping. It resolves
  // modules under Node's rules, not the browser ones configured above.
  "exclude": ["dev-harness/generatePatch.ts"]
}
