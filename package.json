{
  "name": "tk-review",
  "version": "0.1.0",
  "description": "Local git diff / PR review tool",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "harness": "vite --open /dev-harness/",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "biome check --write .",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@comark/react": "^0.6.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@pierre/diffs": "^1.3.1",
    "@tanstack/query-async-storage-persister": "^5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "@tanstack/react-table": "^9.2.4",
    "@tauri-apps/api": "3.0.0-alpha.2",
    "@tauri-apps/plugin-dialog": "3.0.0-alpha.3",
    "@tauri-apps/plugin-opener": "3.0.0-alpha.2",
    "comark": "^0.6.0",
    "dompurify": "^3.4.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "3.0.0-alpha.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
