{
  "name": "tk-review",
  "version": "0.1.0",
  "description": "Local git diff / PR review tool",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "harness": "vite --open /dev-harness/",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@comark/react": "^0.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@pierre/diffs": "^1.3.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "comark": "^0.6.0",
    "dompurify": "^3.4.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
